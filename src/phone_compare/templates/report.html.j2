    if (DATA.derived && DATA.derived[c]) {
      html += `<input id="${id}" data-derived="${esc(c)}" disabled placeholder="calculated automatically">
        <span class="hint">Calculated from ${esc(DATA.derived[c])} when you save.</span>`;
    } else if (type === "ranked") {
      const known = DATA.rankValues[c] || [];
      html += `<input id="${id}" name="${esc(c)}" list="dl-${id}" data-ranked="${esc(c)}" placeholder="pick or type a new one">
        <datalist id="dl-${id}">${known.map((v) => `<option value="${esc(v)}">`).join("")}</datalist>
        <div class="newrank" data-for="${esc(c)}">
          <span class="full">New value: give it a rank to add it to ranks/${esc(DATA.rankFiles[c] || "…")} (1 = best; current best → worst: ${esc(known.join(" › ") || "none")})</span>
          <input name="__rank" placeholder="Rank (1 = best)" inputmode="decimal">
          <input name="__score" placeholder="Score (optional)" inputmode="decimal">
          <input name="__details" placeholder="Details (optional)" style="grid-column:1/-1">
        </div>`;
    } else if (type === "higher" || type === "lower") {
      html += `<input id="${id}" name="${esc(c)}" inputmode="decimal" placeholder="number">`;
    } else if (wide) {
      html += `<textarea id="${id}" name="${esc(c)}" rows="2"></textarea>`;
    } else {
      html += `<input id="${id}" name="${esc(c)}">`;
    }
    html += "</div>";
  }
  html += `<div class="actions">
      <button type="submit" class="btn primary" ${SERVER ? "" : "disabled"}>Add phone</button>
      <button type="button" class="btn" id="copy-row">Copy CSV row</button>
      <button type="reset" class="btn">Clear</button>
      <span class="muted">* required. Numbers can use , or . for decimals.</span></div>`;
  f.innerHTML = html;
  f.querySelectorAll("[data-ranked]").forEach((inp) => inp.addEventListener("input", () => {
    const known = DATA.rankValues[inp.dataset.ranked] || [];
    f.querySelector(`.newrank[data-for="${CSS.escape(inp.dataset.ranked)}"]`).classList.toggle("show", !!inp.value.trim() && !known.includes(inp.value.trim()));
  }));
  f.addEventListener("reset", () => setTimeout(() => { f.querySelectorAll(".newrank").forEach((d) => d.classList.remove("show")); updateNameStatus(); }, 0));
  f.querySelector("#f-name").addEventListener("input", updateNameStatus);
}
// tell the user, while typing, whether saving will ADD a new phone or REPLACE an existing one
function updateNameStatus() {
  const name = $("#f-name").value.trim(), exists = DATA.phones.includes(name);
  const submit = $('#add-form button[type="submit"]'), st = $("#name-status");
  if (submit) submit.textContent = exists ? "Save (replace data)" : "Add phone";
  st.innerHTML = !name ? "A new name adds a phone; an existing name replaces that phone's data."
    : exists ? `<b style="color:var(--miss-t)">Already in the list:</b> saving replaces the data of <b>${esc(name)}</b>.`
             : (state.editing ? `<b style="color:var(--other)">New name:</b> saving creates a new phone (<b>${esc(state.editing)}</b> stays as it is).`
                              : `<b style="color:var(--good)">New phone</b>: it will be added to the list.`);
}
function readForm() {
  const f = $("#add-form"), values = {}, ranks = {};
  values[DATA.nameColumn] = f.querySelector("#f-name").value.trim();
  for (const c of fileColumns()) {
    const inp = f.querySelector(`[name="${CSS.escape(c)}"]`);
    values[c] = inp ? inp.value.trim() : "";
    const nr = f.querySelector(`.newrank[data-for="${CSS.escape(c)}"]`);
    if (nr && nr.classList.contains("show")) {
      ranks[c] = { rank: nr.querySelector('[name="__rank"]').value, score: nr.querySelector('[name="__score"]').value,
                   details: nr.querySelector('[name="__details"]').value };
    }
  }
  return { values, ranks };
}
$("#add-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const { values, ranks } = readForm();
  const box = $("#add-result");
  try {
    const res = await api("api/phones", { values, ranks });   // same name = replace, new name = add
    box.innerHTML = `<div class="alerts ok"><b>Done.</b><ul>${res.messages.map((m) => `<li>${esc(m)}</li>`).join("")}</ul>Reloading…</div>`;
    setTimeout(() => location.reload(), 1800);
  } catch (err) {
    box.innerHTML = `<div class="alerts bad">⚠ ${esc(err.message)}</div>`;
  }
});
document.addEventListener("click", (e) => {
  if (e.target.id !== "copy-row") return;
  const { values } = readForm();
  const cells = [values[DATA.nameColumn], ...fileColumns().map((c) => values[c])].map((v) => /[",;\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v);
  const line = cells.join(",");
  $("#add-result").innerHTML = `<p class="muted">Paste this line at the end of <code>data/phones.csv</code>:</p><pre class="row">${esc(line)}</pre>`;
  navigator.clipboard?.writeText(line).then(() => toast("CSV row copied to the clipboard."), () => {});
});

// ================================================================== edit mode
function setFormMode(name) {
  state.editing = name;
  $("#add-title").textContent = name ? "Edit phone" : "Add a phone";
  $("#add-tab-btn").textContent = name ? "Edit phone" : "Add phone";
  updateNameStatus();
  const help = $("#add-help"); if (help) help.style.display = name ? "none" : "";
  const banner = $("#edit-banner");
  banner.style.display = name ? "block" : "none";
  banner.innerHTML = name ? `Editing <b>${esc(name)}</b>: every field shows its current data. Change what was wrong and save.
    <b>Same name</b> → its data is replaced. <b>Different name</b> → a new phone is created and this one is kept.
    <button type="button" class="btn small" id="cancel-edit">Cancel</button>` : "";
  $("#add-result").innerHTML = "";
}
function startEdit(name) {
  const f = $("#add-form");
  state.editing = null;   // so the reset below doesn't schedule leaving edit mode
  f.reset();
  f.querySelector("#f-name").value = name;
  const src = (DATA.raw && DATA.raw[name]) || DATA.values[name] || {};    // values exactly as typed in the CSV
  for (const c of DATA.columns) {
    const inp = f.querySelector(`[name="${CSS.escape(c)}"]`);
    if (inp) { inp.value = src[c] ?? ""; inp.dispatchEvent(new Event("input")); }
    const d = f.querySelector(`[data-derived="${CSS.escape(c)}"]`);
    if (d) d.value = src[c] ?? "";
  }
  setFormMode(name);
  showTab("add");
}
document.addEventListener("click", (e) => {
  if (e.target.id === "cancel-edit") { $("#add-form").reset(); setFormMode(null); showTab("phones"); }
});
$("#add-form").addEventListener("reset", () => { if (state.editing) setTimeout(() => setFormMode(null), 0); });

// ================================================================== tabs & wiring
function showTab(name) {
  $$(".tabs button").forEach((b) => b.classList.toggle("active", b.dataset.tab === name));
  $$("section.tab").forEach((s) => s.classList.toggle("active", s.id === "tab-" + name));
  currentTab = name; updateHash();
  $("#base-bar").classList.toggle("hidden", !["home", "perspec", "perphone"].includes(name));
  $("#home-nav").style.display = name === "home" ? "" : "none";
  if (name === "add" && !state.editing) setFormMode(null);
  window.scrollTo({ top: 0 });
}
document.addEventListener("click", (e) => {
  const go = e.target.closest("[data-goto]");
  if (go) { e.preventDefault(); if (go.dataset.goto === "add") { $("#add-form").reset(); setFormMode(null); } showTab(go.dataset.goto); return; }
  const jump = e.target.closest("[data-jump]");
  if (jump) { e.preventDefault(); document.getElementById(jump.dataset.jump)?.scrollIntoView({ behavior: "smooth", block: "start" }); }
});
$$(".tabs button").forEach((b) => b.addEventListener("click", () => {
  if (b.dataset.tab === "add" && state.editing && currentTab !== "add") { $("#add-form").reset(); setFormMode(null); }
  showTab(b.dataset.tab);
}));
$("#base").addEventListener("change", (e) => { state.base = e.target.value; changed(); });
function changed() { renderReport(); renderPhonePicker(); renderSpecPicker(); }

const params = new URLSearchParams(location.hash.slice(1));
const fromHash = params.get("base");
if (fromHash && DATA.phones.includes(fromHash)) { state.base = fromHash; state.phones.add(fromHash); }
renderIssues(); renderAddForm(); changed();
showTab(["perspec", "perphone", "phones", "specs", "add"].includes(params.get("tab")) ? params.get("tab") : "home");
if (DATA.phones.includes(params.get("edit"))) startEdit(params.get("edit"));
</script>
</body>
</html>
